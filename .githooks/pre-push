# 1) Any tag being pushed must match package.json at that tag
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/tags/v*)
      tag="${local_ref#refs/tags/}"
      version=$(git show "$tag:package.json" | node -p "JSON.parse(require('fs').readFileSync(0,'utf8')).version")
      if [ "$tag" != "v$version" ]; then
        echo "✖ Tag $tag doesn't match package.json ($version) at that tag."
        exit 1
      fi
      ;;
  esac
done

# 2) package.json's current version must already be tagged
version=$(node -p "require('./package.json').version")
if ! git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
  echo "✖ package.json is $version but tag v$version doesn't exist. Run: pnpm release"
  exit 1
fi

